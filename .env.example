# Copy this file to .env.local and fill in the values.
#
# Both of these are safe in the browser. The publishable key grants nothing
# on its own, because row level security decides what a signed in person
# can read. Do not put the service role key here or anywhere in src/.
#
# For the Cloudflare deploy, set the same two as build environment
# variables in the Workers Builds settings. Vite reads them at build time,
# not at run time.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
